PORT=3000
FRONTEND_URL=http://localhost:5500
# Optional: comma-separated list of extra allowed origins (e.g. your phone's
# local IP if the frontend is opened from another device on the same network).
# Example: ALLOWED_ORIGINS=http://localhost:5500,http://192.168.1.23:5500
ALLOWED_ORIGINS=

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# IMPORTANT: use the SERVICE ROLE key (not the anon/public key) - this key is
# server-only and must never be exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_EMAIL=admin@zyrex.local
ADMIN_PASSWORD=change-this-immediately
# Generate a hash with: node -e "const c=require('crypto');const p='YOUR_PASSWORD';const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(p,s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=

# AI CHAT (server-side only; never expose these values in frontend JS)
AI_API_KEY=replace_with_your_ai_key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=replace_with_your_model

